{
  "name": "RAG Customer Support Email Agent",
  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "name": "When clicking ‘Execute workflow’"
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "queryString": "Ecommerce_Customer_Support_Knowledge_Base",
        "returnAll": true,
        "filter": {},
        "options": {}
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "name": "Find Knowledge Base Folder"
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "searchMethod": "query",
        "queryString": "='{{ $json.id }}' in parents",
        "returnAll": true,
        "filter": {},
        "options": {}
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "name": "Get Knowledge Base Documents"
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": {
          "__rl": true,
          "value": "={{ $json.id }}",
          "mode": "id"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "name": "Download Knowledge Document"
    },
    {
      "parameters": {
        "mode": "insert",
        "pineconeIndex": {
          "__rl": true,
          "value": "REPLACE_WITH_YOUR_PINECONE_INDEX",
          "mode": "list",
          "cachedResultName": "your-index"
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.vectorStorePinecone",
      "typeVersion": 1.3,
      "name": "Store Knowledge in Pinecone",
      "notes": "Always Output Data"
    },
    {
      "parameters": {
        "dataType": "binary",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "name": "Default Data Loader"
    },
    {
      "parameters": {
        "options": {
          "dimensions": 512
        }
      },
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "name": "Embeddings OpenAI"
    },
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "filters": {}
      },
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.4,
      "name": "Gmail Trigger"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "45fd1212-12e6-4008-8a15-ce0172d27267",
              "name": "customer_name",
              "value": "={{ $json.From.split('<')[0].trim() }}",
              "type": "string"
            },
            {
              "id": "c6de9d06-54bd-4dc9-a38c-855a011c3f3c",
              "name": "customer_email",
              "value": "={{ $json.From.match(/<([^>]+)>/)?.[1] || $json.From }}",
              "type": "string"
            },
            {
              "id": "a59abad3-defc-4b77-bfaa-07d952484a70",
              "name": "subject",
              "value": "={{ $json.Subject }}",
              "type": "string"
            },
            {
              "id": "7003a308-a5ac-42b2-97c7-970d05b17e54",
              "name": "customer_message",
              "value": "={{ $json.snippet }}",
              "type": "string"
            },
            {
              "id": "5e0d8d03-f289-440b-a690-6ff61a95d24a",
              "name": "message_id",
              "value": "={{ $json.id }}",
              "type": "string"
            },
            {
              "id": "9ddb269d-7512-4b12-8908-4b3201071a3f",
              "name": "thread_id",
              "value": "={{ $json.threadId }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "name": "Process Customer Email"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "9c829f75-38d7-4180-bd6d-cbf0cc84c99e",
              "name": "customer_query",
              "value": "={{ $json.customer_message }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "name": "Prepare Customer Query"
    },
    {
      "parameters": {
        "mode": "load",
        "pineconeIndex": {
          "__rl": true,
          "value": "REPLACE_WITH_YOUR_PINECONE_INDEX",
          "mode": "list",
          "cachedResultName": "your-index"
        },
        "prompt": "={{ $json.customer_query }}",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.vectorStorePinecone",
      "typeVersion": 1.3,
      "name": "Retrieve Relevant Knowledge"
    },
    {
      "parameters": {
        "options": {
          "dimensions": 512
        }
      },
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "name": "Embeddings OpenAI1"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an AI customer support agent for an e-commerce company.\n\nAnswer the customer's email using ONLY the information provided in the Knowledge Base below.\n\nIf the Knowledge Base does not contain enough information to answer the question, do not make up an answer. Instead, politely say that the issue needs to be reviewed by the support team.\n\nCustomer Name:\n{{ $('Gmail Trigger').item.json.From.split('<')[0].trim() }}\n\nKnowledge Base:\n{{ $json.knowledge_context }}\n\nCustomer Question:\n{{ $('Prepare Customer Query').item.json.customer_query }}\n\nWrite a clear, friendly and professional email reply.\n\nImportant:\n- Do NOT write a subject line.\n- Do NOT write \"Subject:\".\n- Do NOT use placeholders such as [Customer's Name], [Your Name], or [Company Name].\n- Start the email with \"Hi\" followed by the customer's name when the name is available.\n- End with next paragrap:\n\n  Format the email as HTML.\n\nUse separate <p> tags for each paragraph.\n\nThe closing must be formatted exactly like this:\n\n<p>Best regards,<br>\nCustomer Support Team</p>\n\nDo not put the closing on the same line as the previous paragraph.\n\nReturn only the email body.",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "name": "AI Agent"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "name": "OpenAI Chat Model"
    },
    {
      "parameters": {
        "fieldsToAggregate": {
          "fieldToAggregate": [
            {
              "fieldToAggregate": "document.pageContent",
              "renameField": true,
              "outputFieldName": "knowledge_context"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "name": "Aggregate"
    },
    {
      "parameters": {
        "sendTo": "={{ $('Gmail Trigger').item.json.From }}",
        "subject": "={{ $('Gmail Trigger').item.json.Subject }}",
        "message": "={{ $('AI Agent').item.json.output }}",
        "options": {
          "appendAttribution": false,
          "replyToSenderOnly": false
        }
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "name": "Send a message"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "728430a4-b1d4-4852-9645-189a620459c4",
              "leftValue": "={{ $json.knowledge_context[0] }}",
              "rightValue": "is not empty",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "name": "Check Knowledge Found"
    },
    {
      "parameters": {
        "operation": "reply",
        "messageId": "={{ $('Gmail Trigger').item.json.id }}",
        "message": "=<p>Hi {{ $('Gmail Trigger').item.json.From.split('<')[0].trim() }},</p>\n\n<p>Thank you for reaching out to us.</p>\n\n<p>Unfortunately, I couldn't find enough information in our available support resources to answer your question accurately.</p>\n\n<p>Our support team will need to review this and provide you with the correct information.</p>\n\n<p>Best regards,<br>\nCustomer Support Team</p>",
        "options": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "name": "Send Fallback Reply"
    }
  ],
  "pinData": {},
  "connections": {
    "When clicking ‘Execute workflow’": {
      "main": [
        [
          {
            "node": "Find Knowledge Base Folder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Find Knowledge Base Folder": {
      "main": [
        [
          {
            "node": "Get Knowledge Base Documents",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Knowledge Base Documents": {
      "main": [
        [
          {
            "node": "Download Knowledge Document",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download Knowledge Document": {
      "main": [
        [
          {
            "node": "Store Knowledge in Pinecone",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Default Data Loader": {
      "ai_document": [
        [
          {
            "node": "Store Knowledge in Pinecone",
            "type": "ai_document",
            "index": 0
          }
        ]
      ]
    },
    "Embeddings OpenAI": {
      "ai_embedding": [
        [
          {
            "node": "Store Knowledge in Pinecone",
            "type": "ai_embedding",
            "index": 0
          }
        ]
      ]
    },
    "Store Knowledge in Pinecone": {
      "main": [
        []
      ]
    },
    "Gmail Trigger": {
      "main": [
        [
          {
            "node": "Process Customer Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process Customer Email": {
      "main": [
        [
          {
            "node": "Prepare Customer Query",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Customer Query": {
      "main": [
        [
          {
            "node": "Retrieve Relevant Knowledge",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Embeddings OpenAI1": {
      "ai_embedding": [
        [
          {
            "node": "Retrieve Relevant Knowledge",
            "type": "ai_embedding",
            "index": 0
          }
        ]
      ]
    },
    "Retrieve Relevant Knowledge": {
      "main": [
        [
          {
            "node": "Aggregate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "AI Agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "AI Agent": {
      "main": [
        [
          {
            "node": "Send a message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Aggregate": {
      "main": [
        [
          {
            "node": "Check Knowledge Found",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Knowledge Found": {
      "main": [
        [
          {
            "node": "AI Agent",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Fallback Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "binaryMode": "separate",
    "availableInMCP": false
  },
  "nodeGroups": []
}